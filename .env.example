# Yoh — environment variables
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# `.env.example` is the only variant tracked in git (see .gitignore).
#
# Per AD-10 of the Architecture Spine: every value below except
# GOOGLE_REFRESH_TOKEN is a *static* secret, loaded once from the
# environment at process start and never rewritten. GOOGLE_REFRESH_TOKEN is
# only a one-time bootstrap seed for the very first run — after that,
# token-store.ts persists every refreshed token to GOOGLE_TOKEN_FILE_PATH on
# disk, not back to this file, so don't expect this value to stay in sync
# with reality after day one.
#
# See SETUP.md for the numbered runbook that gets you the values below.

# ---------------------------------------------------------------------------
# Google OAuth (src/adapters/token-store.ts)
# ---------------------------------------------------------------------------

# From the OAuth 2.0 Client ID you create in the Google Cloud Console
# (SETUP.md step 3).
GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=

# Must exactly match a "Authorized redirect URI" configured on that OAuth
# client. http://localhost:<port>/oauth2callback is fine for a script that
# only ever runs on Spencer's own machine (Desktop-app-style flow).
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# One-time bootstrap value obtained via the manual consent-URL flow in
# SETUP.md step 6. Only read if GOOGLE_TOKEN_FILE_PATH doesn't already
# exist on disk; every subsequent refresh is written to that file instead.
GOOGLE_REFRESH_TOKEN=

# One-time bootstrap value for AD-13's SECOND, broader-scoped client
# (calendar.events — read/write across all accessible calendars), obtained
# via a SEPARATE manual OAuth consent flow requesting that broader scope
# (see SETUP.md; same flow shape as GOOGLE_REFRESH_TOKEN above, a different
# consent grant). Only read if the token file's own `broadRefreshToken`
# doesn't already exist — every subsequent refresh is written there
# instead. Required only for Story 6.6/FR-27's confirm-gated Calendar
# editing; every other capability works without it.
GOOGLE_BROAD_REFRESH_TOKEN=

# Where token-store.ts persists the refresh token (and, once
# calendar-adapter.ts creates it, the "Yoh Plan" secondary calendar id).
# Defaults to ./data/google-token.json if unset.
GOOGLE_TOKEN_FILE_PATH=./data/google-token.json

# ---------------------------------------------------------------------------
# Notion (notion-adapter.ts — a later task)
# ---------------------------------------------------------------------------

# Internal integration token ("secret_..." / "ntn_..."), from SETUP.md step 7.
# Confirmed live (2026-08-22) against https://developers.notion.com/docs/authorization:
# internal integrations use a static per-workspace token, no OAuth flow —
# matches AD-10's "static, non-refreshing secret" assumption for Notion.
NOTION_TOKEN=

# Confirmed live (2026-08-22) against https://developers.notion.com/reference/versioning:
# current Notion API version is 2026-03-11. Pin it explicitly rather than
# relying on the SDK's own bundled default, so a future SDK upgrade can't
# silently change the wire format Yoh depends on.
NOTION_API_VERSION=2026-03-11

# The data source ids of Spencer's Tasks and Projects databases — what
# notion-adapter.ts's `readNotionTasks` queries. Under Notion's current
# "a database contains one or more data sources" model these are data
# source ids, not database ids.
NOTION_TASKS_DATA_SOURCE_ID=
NOTION_PROJECTS_DATA_SOURCE_ID=

# Overrides notion-adapter.ts's DEFAULT_TASK_PROPERTY_NAMES.title ("Name")
# when the Tasks database's title property is named something else — e.g.
# Spencer's real workspace names it "Task Name". Leave unset to use "Name".
NOTION_TASK_TITLE_PROPERTY=

# The data source id of Spencer's Research Vault database — confirmed live
# 2026-09-18 (Story 6.1 spike): the "Research Vault" database, id
# 33ee0769-3060-81e9-bfd6-dd1183c25040, data source id
# 33ee0769-3060-8103-86f6-000be2d03654. Used by Story 6.3/6.5's
# createPage(database: 'ResearchVault', ...). Requires the Notion
# integration to be shared with this specific database in Notion's
# "Connections" UI — it is NOT shared by default alongside Tasks/Projects.
NOTION_RESEARCH_VAULT_DATA_SOURCE_ID=

# ---------------------------------------------------------------------------
# Spencer's timezone (src/shell/ritual-cli.ts, src/shell/chat-cli.ts,
# src/rituals/morning-ritual.ts)
# ---------------------------------------------------------------------------

# IANA zone name, e.g. America/New_York. REQUIRED — deliberately not
# defaulted to UTC anywhere: "today" has to be Spencer's own calendar day or
# calendar-adapter.ts silently drops late-evening events, the Morning Ritual
# can generate a Plan for the wrong date, and chat-cli.ts's on-demand Plan
# view (Task 11) can miss today's Plan or show a stale prior day's. See
# calendar-adapter.ts's module docstring for the full reasoning.
YOH_TIMEZONE=

# ---------------------------------------------------------------------------
# Pushover (notification-adapter.ts)
# ---------------------------------------------------------------------------

# Required for ALL FOUR ritual-cli.ts subcommands (morning, night-prompt,
# night-escalate, self-check) as of Task 25 / Story 5.1: AD-7's failure-alert
# channel (src/shell/ritual-cli.ts's `withFailureAlert`/
# `createFailureAlertSender`) sends its "a ritual failed" alert over Pushover
# regardless of which subcommand failed — including night-escalate, whose own
# ritual otherwise only ever sends email (see createNightEscalateRitualDeps's
# doc comment).
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# ---------------------------------------------------------------------------
# SMTP (adapters/email-adapter.ts, Task 20; email channel for
# night-escalate's capped second close-out attempt, FR-13/FR-14)
# ---------------------------------------------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---------------------------------------------------------------------------
# Perplexity (adapters/search-adapter.ts — FR-28, Story 6.4)
# ---------------------------------------------------------------------------

# Targets Perplexity's Agent API (/v1/responses), not the deprecated Sonar
# /v1/chat/completions endpoint (see ARCHITECTURE-SPINE.md AD-14).
PERPLEXITY_API_KEY=

# ---------------------------------------------------------------------------
# Claude API (plan-reasoning.ts / chat-cli.ts — a later task)
# ---------------------------------------------------------------------------

CLAUDE_API_KEY=

# ---------------------------------------------------------------------------
# memory-store.ts
# ---------------------------------------------------------------------------

# Path to the SQLite file memory-store.ts owns (hot/cold memory, open
# interaction requests / Proposals). Defaults to ./data/yoh-memory.db if
# unset — later tasks that wire this up may choose to hardcode a default
# instead of requiring this var; kept here for explicitness/override.
MEMORY_DB_PATH=./data/yoh-memory.db

# ---------------------------------------------------------------------------
# Yoh server (src/shell/server.ts — Story 7.2, AD-15; deploy/DEPLOY.md)
# ---------------------------------------------------------------------------

# Loopback port the server binds (always 127.0.0.1, never 0.0.0.0).
# `tailscale serve --bg <port>` must point at this same port. Defaults to
# 8787 if unset.
YOH_SERVER_PORT=8787
